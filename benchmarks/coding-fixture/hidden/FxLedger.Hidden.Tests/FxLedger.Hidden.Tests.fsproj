<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hidden evaluation tests. Copied next to a sandbox's fx-ledger by the evaluator; never shown to agents. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="T1Total.fs" />
    <Compile Include="T2AddEntry.fs" />
    <Compile Include="T3Approve.fs" />
    <Compile Include="T4Balance.fs" />
    <Compile Include="T5View.fs" />
    <Compile Include="T6Csv.fs" />
    <Compile Include="T7Currency.fs" />
    <Compile Include="T8Refund.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../fx-ledger/src/FxLedger/FxLedger.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
